# MongoDB Atlas Connection String (required for production & local dev)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexus_observability?retryWrites=true&w=majority

# Cryptographically random secret for signing JWT access tokens (minimum 32 characters recommended)
JWT_SECRET=replace_with_a_64_char_cryptographic_secret_key_for_nexus_cipher_logiq

# JWT token expiration window (e.g., 7d, 24h)
JWT_EXPIRES_IN=7d

# Runtime environment: development | production | test
NODE_ENV=development

# Local backend port (ignored on Vercel serverless; avoids macOS AirPlay on 5000)
PORT=5001

# Optional comma-separated allowed CORS origins for strict deployments
CORS_ORIGIN=http://localhost:5173
