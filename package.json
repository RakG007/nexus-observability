{
  "name": "nexus-observability",
  "version": "1.0.0",
  "description": "Nexus: Real-Time Server Observability Platform by Cipher Logiq (Developer: Rakshak Gupta)",
  "main": "backend/app.js",
  "scripts": {
    "dev:backend": "nodemon backend/app.js",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "node backend/app.js",
    "install:all": "npm install && npm --prefix frontend install",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "test": "NODE_ENV=test jest --runInBand --forceExit",
    "test:backend": "NODE_ENV=test jest --runInBand --forceExit"
  },
  "keywords": [
    "observability",
    "logs",
    "regex",
    "mern",
    "vercel",
    "security",
    "cipher-logiq"
  ],
  "author": "Rakshak Gupta (Cipher Logiq)",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
